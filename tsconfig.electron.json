{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "noEmit": false,
        "outDir": "dist-electron",
        "target": "ESNext",
        "lib": [
            "ESNext"
        ],
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "esModuleInterop": true
    },
    "include": [
        "electron"
    ]
}